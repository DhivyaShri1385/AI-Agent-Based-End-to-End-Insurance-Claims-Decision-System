APP_NAME=ClaimIQ
APP_VERSION=0.1.0
ENVIRONMENT=development

# SQLite (default, no setup needed):
DATABASE_URL=sqlite:///./claimiq.db
# PostgreSQL (switch when ready; requires: pip install "psycopg[binary]"):
# DATABASE_URL=postgresql+psycopg://claimiq:claimiq_password@localhost:5432/claimiq

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Generate a real one: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start outside ENVIRONMENT=development with the built-in default.
SECRET_KEY=dev-only-insecure-secret-change-me-before-any-real-use
ACCESS_TOKEN_EXPIRE_MINUTES=60
BCRYPT_ROUNDS=12
